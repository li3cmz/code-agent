# Azure AI Foundry — direct model inference (Chat Completions / Responses API)
# Copy this file to .env and fill in real values.

# Foundry model endpoint. For the OpenAI-compatible v1 path this looks like:
#   https://<your-resource>.cognitiveservices.azure.com/openai/v1/
AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/openai/v1/

# API key from the Foundry portal (use this OR set AZURE_USE_ENTRA_ID=true)
AZURE_FOUNDRY_API_KEY=<your-api-key>

# Use Microsoft Entra ID (DefaultAzureCredential) instead of API key.
# When true, AZURE_FOUNDRY_API_KEY is ignored.
# Run 'az login' first, and ensure you have 'Cognitive Services User' RBAC role.
# Options: true | false (default)
AZURE_USE_ENTRA_ID=false

# Deployment / model name (e.g. gpt-5-mini, gpt-4.1, gpt-4o).
MODEL=gpt-5-mini
