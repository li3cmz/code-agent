# Azure AI Foundry — direct model inference (Chat Completions / Responses API)
# Copy this file to .env and fill in real values.

# Foundry model endpoint. For the OpenAI-compatible v1 path this looks like:
#   https://<your-resource>.openai.azure.com/openai/v1/
AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/

# API key from the Foundry portal (MVP auth).
AZURE_FOUNDRY_API_KEY=<your-api-key>

# Deployment / model name (e.g. gpt-4.1, gpt-4o, gpt-4.1-mini).
MODEL=gpt-4.1
