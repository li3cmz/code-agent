{
  "name": "code-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A code CLI agent built from scratch, following Claude Code's architecture, using Azure AI Foundry for model inference.",
  "scripts": {
    "smoke": "tsx src/smoke.ts",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/mcp": "^2.0.5",
    "dotenv": "^16.4.5",
    "openai": "^4.68.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^1.6.0"
  }
}
